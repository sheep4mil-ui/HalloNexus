{
  "extensionName": "Universal Keyboard and Sound Pack",
  "category": "CONTROLS",
  "newBlocks": [
    {
      "blockName": "WHEN BUTTON PRESSED",
      "tooltip": "Scans the calculator keys to see if a button is being pushed by the user.",
      "sideMenuFields": [
        { "label": "Target Key", "type": "text", "default": "sk_2nd" }
      ],
      "ez80AssemblyTemplate": "call _GetCSC\ncp {TargetKey}\njr nz, _KeyCheckFailed"
    },
    {
      "blockName": "WHEN BOTH BUTTONS HELD",
      "tooltip": "Triggers a logical branch path if two keys are being pressed simultaneously.",
      "sideMenuFields": [
        { "label": "Key Alpha", "type": "text", "default": "sk_Right" },
        { "label": "Key Beta", "type": "text", "default": "sk_Alpha" }
      ],
      "ez80AssemblyTemplate": "call _GetCSC\nld b, a\ncp {KeyAlpha}\njr nz, _ComboFailed\nld a, b\ncp {KeyBeta}\njr nz, _ComboFailed"
    },
    {
      "blockName": "PLAY MUSIC NOTE",
      "tooltip": "Blasts a musical pitch out of the link jack port pins at a set tempo rhythm.",
      "sideMenuFields": [
        { "label": "Note Pitch Hz", "type": "number", "default": 440 },
        { "label": "Length Ms", "type": "number", "default": 250 }
      ],
      "ez80AssemblyTemplate": "ld hl, {NotePitchHz}\nld de, {LengthMs}\ncall _GenerateSquareWavePulse"
    },
    {
      "blockName": "PLAY EXPLOSION SOUND",
      "tooltip": "Generates a retro crunchy noise effect for explosions or crashes.",
      "sideMenuFields": [],
      "ez80AssemblyTemplate": "call _TriggerProceduralNoiseExplosion"
    },
    {
      "blockName": "WAIT TIMER TICK",
      "tooltip": "Forces the game thread script to pause for a moment before continuing downstream logic.",
      "sideMenuFields": [
        { "label": "Ticks Delay", "type": "number", "default": 30 }
      ],
      "ez80AssemblyTemplate": "ld b, {TicksDelay}\ncall _SuspendThreadTimedTick"
    },
    {
      "blockName": "LOAD NEXT SEQUEL",
      "tooltip": "Saves your score data and securely opens up an entirely separate sequel game file.",
      "sideMenuFields": [
        { "label": "Sequel App Name", "type": "text", "default": "GAME2" }
      ],
      "ez80AssemblyTemplate": "ld hl, {SequelAppName}\ncall _ExecuteSecureLauncherPayloadWrapper"
    }
  ]
}
