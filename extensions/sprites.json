{
  "extensionName": "Core Sprite Mechanics Pack",
  "category": "Sprites",
  "newBlocks": [
    {
      "blockName": "Initialize Player Sprite",
      "tooltip": "Sets up the core player object-pool tracking memory array in background RAM.",
      "sideMenuFields": [
        { "label": "Starting X Coordinate", "type": "number", "default": 160 },
        { "label": "Starting Y Coordinate", "type": "number", "default": 120 },
        { "label": "Max Health Points", "type": "number", "default": 100 }
      ],
      "ez80AssemblyTemplate": "ld a, {MaxHealthPoints}\nld (Player_Max_HP), a\nld hl, {StartingXCoordinate}\nld (Player_X_Pos), hl\nld de, {StartingYCoordinate}\nld (Player_Y_Pos), de\ncall _InitPlayerObjectPool"
    },
    {
      "blockName": "Trigger High-Juice Screen Shake",
      "tooltip": "Executes a hardware-accelerated screen shake by manipulating the VRAM LCD offset line.",
      "sideMenuFields": [
        { "label": "Shake Intensity Scale", "type": "number", "default": 4 },
        { "label": "Duration In Frames", "type": "number", "default": 15 }
      ],
      "ez80AssemblyTemplate": "ld a, {ShakeIntensityScale}\nld b, {DurationInFrames}\ncall _ExecuteCameraHardwareShake"
    },
    {
      "blockName": "Emit Object-Pooled Projectile",
      "tooltip": "Fires a bullet from the recycled memory cache pool to eliminate active processor lag.",
      "sideMenuFields": [
        { "label": "Velocity Vector Speed", "type": "number", "default": 6 },
        { "label": "Target Destination Offset", "type": "text", "default": "In-Game_Cursor" }
      ],
      "ez80AssemblyTemplate": "ld a, {VelocityVectorSpeed}\ncall _FetchEmptyBulletMemorySlot\ncall _CalculateReticleVectorAngle\ncall _InjectActiveBulletStream"
    }
  ]
}
