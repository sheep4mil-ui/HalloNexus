{
  "extensionName": "Universal Logic, Controls & Code Injection Core",
  "category": "LOGIC",
  "newBlocks": [
    {
      "blockName": "START BLOCK",
      "tooltip": "The execution map initialization root entry.",
      "sideMenuFields": [],
      "ez80AssemblyTemplate": "_Start_Program_Execution_Entry:\n    call _ResetGlobalVariableMatrix"
    },
    {
      "blockName": "LOOP BLOCK",
      "tooltip": "Continuous engine logic runtime step execution.",
      "sideMenuFields": [
        { "label": "Target Frame FPS", "type": "number", "default": 60 }
      ],
      "ez80AssemblyTemplate": "_Main_Game_Loop_Tick:\n    call _SuspendThreadTimedTick"
    },
    {
      "blockName": "CUSTOM CODE INJECTOR",
      "tooltip": "Inject raw text data streams inputs.",
      "sideMenuFields": [
        { "label": "Target Lang", "type": "text", "default": "python" },
        { "label": "Raw Input Snippet", "type": "text", "default": "print('Hello HallowNexus')" }
      ],
      "ez80AssemblyTemplate": "; --- Raw Code Injection Target: {TargetLang} ---\n{RawInputSnippet}"
    },
    {
      "blockName": "ALLOCATE STORAGE BAG",
      "tooltip": "Pre-allocates index tracker limits.",
      "sideMenuFields": [
        { "label": "Max Item Capacity", "type": "number", "default": 10 },
        { "label": "Stride Slot Bytes", "type": "number", "default": 2 }
      ],
      "ez80AssemblyTemplate": "ld a, {MaxItemCapacity}\nld b, {StrideSlotBytes}\ncall _AllocateItemPointerGrid"
    },
    {
      "blockName": "TOGGLE INVENTORY ATTRIBUTE",
      "tooltip": "Modifies slots fields states items flags.",
      "sideMenuFields": [
        { "label": "Item Array Index", "type": "number", "default": 0 },
        { "label": "Attribute Bit", "type": "number", "default": 1 }
      ],
      "ez80AssemblyTemplate": "ld a, {ItemArrayIndex}\nld b, {AttributeBit}\ncall _SetInventoryAttributeMatrixFlag"
    },
    {
      "blockName": "ALLOCATE QUICK HOTBAR",
      "tooltip": "Sets up active selected shortcut variables.",
      "sideMenuFields": [
        { "label": "Max Slots", "type": "number", "default": 8 },
        { "label": "Initial Slot", "type": "number", "default": 1 }
      ],
      "ez80AssemblyTemplate": "ld a, {MaxSlots}\nld (MaxHotbarSlots), a\nld a, {InitialSlot}\nld (CurrentActiveSlotIndex), a"
    },
    {
      "blockName": "COMPUTE MINIMAP MATRIX",
      "tooltip": "Down-samples layout arrays onto overlay nodes.",
      "sideMenuFields": [
        { "label": "Minimap Location X", "type": "number", "default": 280 },
        { "label": "Minimap Location Y", "type": "number", "default": 10 },
        { "label": "Scaling Multiplier", "type": "number", "default": 2 }
      ],
      "ez80AssemblyTemplate": "ld hl, {MinimapLocationX}\nld de, {MinimapLocationY}\nld a, {ScalingMultiplier}\ncall _BlitMinimapGridChunk"
    },
    {
      "blockName": "CREATE ITEMS INVENTORY",
      "tooltip": "Establishes a static data matrix memory footprint.",
      "sideMenuFields": [
        { "label": "Total Slots", "type": "number", "default": 10 }
      ],
      "ez80AssemblyTemplate": "ld a, {TotalSlots}\ncall _AllocateItemPointerGrid"
    },
    {
      "blockName": "ADD ITEM TO INVENTORY",
      "tooltip": "Registers collected metrics flags parameters.",
      "sideMenuFields": [
        { "label": "Item Slot ID", "type": "number", "default": 0 }
      ],
      "ez80AssemblyTemplate": "ld a, {ItemSlotID}\ncall _SetInventoryAttributeMatrixFlag"
    },
    {
      "blockName": "MATH CALCULATE VALUE",
      "tooltip": "Computes global numerical modifiers registers.",
      "sideMenuFields": [
        { "label": "Target Tracker", "type": "text", "default": "Player_Score" },
        { "label": "Add Amount", "type": "number", "default": 10 }
      ],
      "ez80AssemblyTemplate": "ld hl, ({TargetTracker})\nld de, {AddAmount}\nadd hl, de\nld ({TargetTracker}), hl"
    },
    {
      "blockName": "CLAMP INSIDE BOUNDS",
      "tooltip": "Restricts value overflow anomalies counters.",
      "sideMenuFields": [
        { "label": "Variable Pointer", "type": "text", "default": "Player_Y" },
        { "label": "Minimum Floor", "type": "number", "default": 0 },
        { "label": "Maximum Ceiling", "type": "number", "default": 240 }
      ],
      "ez80AssemblyTemplate": "ld hl, ({VariablePointer})\nld de, {MinimumFloor}\nor a\nsbc hl, de\njr nc, _CeilCheck\nld hl, {MinimumFloor}\n_CeilCheck:\nld de, {MaximumCeiling}\nor a\nsbc hl, de\njr c, _ClampDone\nld hl, {MaximumCeiling}\n_ClampDone:\nld ({VariablePointer}), hl"
    }
  ]
}
