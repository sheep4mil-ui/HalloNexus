{
  "extensionName": "Universal Map and Scene Pack",
  "category": "SCENE",
  "newBlocks": [
    {
      "blockName": "GO TO STAGE MAP",
      "tooltip": "Binds a 2D tile array grid onto your background rendering engine map data list.",
      "sideMenuFields": [
        { "label": "Map Pointer Data", "type": "text", "default": "Stage1Data" }
      ],
      "ez80AssemblyTemplate": "ld hl, {MapPointerData}\ncall _LoadGlobalMapMatrix"
    },
    {
      "blockName": "TURN ON TORCH MASK",
      "tooltip": "Overlays a dark mask layer over the map screen with a moving light cone centered on a character.",
      "sideMenuFields": [
        { "label": "Follow Char Slot", "type": "number", "default": 1 }
      ],
      "ez80AssemblyTemplate": "ld a, {FollowCharSlot}\ncall _BlitHardwareLightingRasterMask"
    }
  ]
}
