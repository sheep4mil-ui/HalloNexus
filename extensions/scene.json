{
  "extensionName": "Universal Environment Panner & Scene Mask Engine",
  "category": "SCENE",
  "newBlocks": [
    {
      "blockName": "SET MAP MATRIX",
      "tooltip": "Binds a 2D tile layout array memory layout block to the retro background map drawing mechanics.",
      "sideMenuFields": [
        { "label": "Data Pointer", "type": "text", "default": "LevelMapData" },
        { "label": "Grid Width", "type": "number", "default": 20 }
      ],
      "ez80AssemblyTemplate": "ld hl, {DataPointer}\nld a, {GridWidth}\ncall _LoadGlobalMapMatrix"
    },
    {
      "blockName": "APPLY LIGHTING MASK",
      "tooltip": "Injects a moving lighting cone, torch, or lighthouse beam using zero-math 1-bit hardware lookup tables.",
      "sideMenuFields": [
        { "label": "Shape Array", "type": "text", "default": "FlashlightCone" },
        { "label": "Slot ID", "type": "number", "default": 1 }
      ],
      "ez80AssemblyTemplate": "ld a, {SlotID}\nld hl, {ShapeArray}\ncall _BlitHardwareLightingRasterMask"
    }
  ]
}
